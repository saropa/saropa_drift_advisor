{
    "cSpell.words": [
        "gphone",
        "pubdev",
        "pubspec",
        "unindexed",
        "unpushed"
    ],
    "code-runner.executorMap": {
        "python": "python -u"
    },
    // TypeScript project-wide error reporting for the extension subfolder
    // Shows ALL errors in Problems panel, not just open files
    "typescript.tsserver.experimental.enableProjectDiagnostics": true,
    "saropaLints.enabled": true,
    "saropaLints.sidebar.showPackageVibrancy": true,
    "saropaLints.sidebar.showSummary": true,
    "saropaLints.sidebar.showSuggestions": true,
    "saropaLints.sidebar.showDriftAdvisor": true,
    "saropaLints.sidebar.showFileRisk": true,
    "saropaLints.sidebar.showSecurityPosture": true,
    "saropaLints.sidebar.showRulePacks": true,
    "saropaLints.sidebar.showTodosAndHacks": true,
    "saropaLints.sidebar.showSuppressions": true,
    "saropaLints.sidebar.showConfig": true,
    "saropaLints.sidebar.showCommandCatalog": true,
    "saropaLints.sidebar.showPackageDetails": true,
    "saropaLints.todosAndHacks.workspaceScanEnabled": true,
    "saropaLints.violationsGroupBy": "severity",
    // Exclude the generated example app build output (~1.1 GB) from the file
    // watcher so opening the project doesn't crawl/index it. Only the build/
    // output is excluded, not example/ source, so example edits still reload.
    "files.watcherExclude": {
        "**/build/**": true,
        "**/example/build/**": true,
        "**/.dart_tool/**": true,
        "**/.claude/worktrees/**": true
    },
    "saropaLogCapture.integrations.adapters": [
        "packages",
        "git",
        "environment",
        "performance",
        "terminal",
        "flutterCrashLogs",
        "crashlytics",
        "testResults"
    ],
    "saropaLints.tier": "professional",
    "search.exclude": {
        "**/build/**": true,
        "**/example/build/**": true,
        "**/.dart_tool/**": true,
        "**/*.g.dart": true,
        "**/*.freezed.dart": true
    },
    "dart.analysisExcludedFolders": [
        "bugs",
        "docs",
        "plans",
        "reports",
        "scripts"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.dart": "${capture}.g.dart, ${capture}.freezed.dart",
        "pubspec.yaml": "pubspec.lock, .metadata, .flutter-plugins, .flutter-plugins-dependencies"
    },
    "files.readonlyInclude": {
        "**/*.g.dart": true,
        "**/*.freezed.dart": true
    }
}